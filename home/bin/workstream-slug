#!/usr/bin/env python3
"""Manage Taskwarrior workstream titles and slugs."""

from __future__ import annotations

import argparse
import sys
from collections import defaultdict
from dataclasses import dataclass

from _workstreams.cmux import workspaces as cmux_workspaces
from _workstreams.errors import WorkstreamError
from _workstreams.models import Task
from _workstreams.resolve import resolve_cmux_workspace, resolve_task, task_token_from_description
from _workstreams.slug import (
    normalized_slug,
    slugify,
    suggested_slug,
    suggested_title,
    validate_slug,
)
from _workstreams.taskwarrior import STATE_TAGS, is_workstream, modify, pending_tasks


@dataclass(frozen=True)
class DoctorFinding:
    level: str
    message: str

    def __str__(self) -> str:
        return f"{self.level}: {self.message}"


def task_label(task: Task) -> str:
    return f"{task.id} {task.uuid} title={task.title or '-'!r} slug={task.slug or '-'!r}"


def command_get(args: argparse.Namespace) -> int:
    task = resolve_task(args.selector)
    print(f"id:          {task.id}")
    print(f"uuid:        {task.uuid}")
    print(f"title:       {task.title or '-'}")
    print(f"slug:        {task.slug or '-'}")
    print(f"suggested:   {suggested_slug(task) or '-'}")
    print(f"description: {task.description}")
    return 0


def command_suggest(args: argparse.Namespace) -> int:
    if args.selector:
        task = resolve_task(args.selector)
        title = suggested_title(task)
        slug = suggested_slug(task)
        print(f"{task.id} {task.uuid} title={title or '-'} slug={slug or '-'}")
        return 0

    for task in pending_tasks(include_waiting=True):
        if is_workstream(task):
            title = suggested_title(task)
            slug = suggested_slug(task)
            print(f"{task.id} {task.uuid} title={title or '-'} slug={slug or '-'} :: {task.description}")
    return 0


def duplicate_slug_tasks(task: Task, slug: str) -> list[Task]:
    return [
        other
        for other in pending_tasks(include_waiting=True)
        if other.uuid != task.uuid and other.slug == slug
    ]


def duplicate_title_tasks(task: Task, title: str) -> list[Task]:
    return [
        other
        for other in pending_tasks(include_waiting=True)
        if other.uuid != task.uuid and other.title == title
    ]


def ensure_unique_identity(task: Task, *, title: str | None = None, slug: str | None = None) -> None:
    if slug:
        duplicates = duplicate_slug_tasks(task, slug)
        if duplicates:
            joined = "; ".join(task_label(other) for other in duplicates)
            raise WorkstreamError(f"slug {slug!r} is already used by pending/waiting task(s): {joined}")
    if title:
        duplicates = duplicate_title_tasks(task, title)
        if duplicates:
            joined = "; ".join(task_label(other) for other in duplicates)
            raise WorkstreamError(f"title {title!r} is already used by pending/waiting task(s): {joined}")


def command_set(args: argparse.Namespace) -> int:
    task = resolve_task(args.selector)
    title = args.title.strip()
    if not title:
        raise WorkstreamError("title cannot be empty")
    slug = normalized_slug(args.slug) if args.slug else normalized_slug(title)
    ensure_unique_identity(task, title=title, slug=slug)
    modify(task.uuid, f"title:{title}", f"slug:{slug}")
    print(f"updated: {task.id} {task.uuid} title={title!r} slug={slug!r}")
    return 0


def command_set_slug(args: argparse.Namespace) -> int:
    task = resolve_task(args.selector)
    slug = normalized_slug(args.slug)
    ensure_unique_identity(task, slug=slug)
    modify(task.uuid, f"slug:{slug}")
    print(f"updated: {task.id} {task.uuid} slug={slug!r}")
    return 0


def command_list(args: argparse.Namespace) -> int:
    for task in pending_tasks(include_waiting=True):
        if not is_workstream(task):
            continue
        state_tags = sorted(task.tags & STATE_TAGS)
        state = state_tags[0] if state_tags else "-"
        print(f"{task.slug or '-':32} {task.title or '-':32} {state:8} {task.uuid}  {task.description}")
    return 0


def cmux_doctor_findings(tasks: list[Task]) -> list[DoctorFinding]:
    findings: list[DoctorFinding] = []
    slug_to_tasks: dict[str, list[Task]] = defaultdict(list)
    title_to_tasks: dict[str, list[Task]] = defaultdict(list)
    for task in tasks:
        if task.slug:
            slug_to_tasks[task.slug].append(task)
        if task.title:
            title_to_tasks[task.title].append(task)

    for workspace in cmux_workspaces():
        if workspace.title == "tasks":
            continue
        title_slug = slugify(workspace.title)
        token = task_token_from_description(workspace)
        likely_task_workspace = bool(token) or bool(slug_to_tasks.get(title_slug)) or bool(title_to_tasks.get(workspace.title))
        if not likely_task_workspace:
            continue

        try:
            resolution = resolve_cmux_workspace(workspace, tasks=tasks)
        except WorkstreamError as exc:
            findings.append(DoctorFinding("error", f"{workspace.display_ref} {workspace.title!r}: {exc}"))
            continue

        task = resolution.task
        if resolution.reason == "legacy-task-token":
            findings.append(DoctorFinding("info", f"{workspace.display_ref} {workspace.title!r} still has legacy visible task:{token}"))
        elif resolution.legacy:
            findings.append(DoctorFinding("warn", f"{workspace.display_ref} {workspace.title!r} resolved by legacy {resolution.reason}: {task_label(task)}"))

        if task.title and workspace.title != task.title:
            findings.append(DoctorFinding("warn", f"{workspace.display_ref} title {workspace.title!r} != task title {task.title!r}: {task_label(task)}"))
        if task.slug and title_slug != task.slug:
            findings.append(DoctorFinding("warn", f"{workspace.display_ref} slugify(title) {title_slug!r} != task slug {task.slug!r}: {task_label(task)}"))
        if not task.slug:
            findings.append(DoctorFinding("warn", f"{workspace.display_ref} linked task has no slug: {task_label(task)}"))

    return findings


def command_doctor(args: argparse.Namespace) -> int:
    tasks = [task for task in pending_tasks(include_waiting=True) if is_workstream(task)]
    findings: list[DoctorFinding] = []

    slug_to_tasks: dict[str, list[Task]] = defaultdict(list)
    title_to_tasks: dict[str, list[Task]] = defaultdict(list)
    title_slug_to_tasks: dict[str, list[Task]] = defaultdict(list)

    for task in tasks:
        state_tags = task.tags & STATE_TAGS
        require_identity = bool(state_tags - {"parked"})

        if not task.title and require_identity:
            findings.append(DoctorFinding("warn", f"missing title: {task_label(task)}"))
        if not task.slug and require_identity:
            findings.append(DoctorFinding("warn", f"missing slug: {task_label(task)}"))

        if task.slug:
            try:
                validate_slug(task.slug)
            except ValueError as exc:
                findings.append(DoctorFinding("error", f"{exc}: {task_label(task)}"))
            slug_to_tasks[task.slug].append(task)

        if task.title:
            title_to_tasks[task.title].append(task)
            title_slug = slugify(task.title)
            if not title_slug:
                findings.append(DoctorFinding("error", f"title slugifies to empty: {task_label(task)}"))
            else:
                title_slug_to_tasks[title_slug].append(task)
                if task.slug and task.slug != title_slug:
                    findings.append(
                        DoctorFinding(
                            "warn",
                            f"slug != slugify(title) ({task.slug!r} != {title_slug!r}): {task_label(task)}",
                        )
                    )

    for slug, matches in sorted(slug_to_tasks.items()):
        if len(matches) > 1:
            joined = "; ".join(task_label(task) for task in matches)
            findings.append(DoctorFinding("error", f"duplicate slug {slug!r}: {joined}"))

    for title, matches in sorted(title_to_tasks.items()):
        if len(matches) > 1:
            joined = "; ".join(task_label(task) for task in matches)
            findings.append(DoctorFinding("warn", f"duplicate title {title!r}: {joined}"))

    for title_slug, matches in sorted(title_slug_to_tasks.items()):
        if len(matches) > 1:
            joined = "; ".join(task_label(task) for task in matches)
            findings.append(DoctorFinding("warn", f"duplicate normalized title {title_slug!r}: {joined}"))

    if args.cmux:
        findings.extend(cmux_doctor_findings(tasks))

    if not findings:
        scope = "Taskwarrior + CMUX" if args.cmux else "Taskwarrior"
        print(f"ok: {len(tasks)} pending/waiting workstream task(s) have valid title/slug identity in {scope}")
        return 0

    for finding in findings:
        print(finding)
    return 1 if any(finding.level == "error" for finding in findings) else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    get = sub.add_parser("get", help="show title/slug for one task")
    get.add_argument("selector", help="task uuid/id/slug/title")
    get.set_defaults(func=command_get)

    set_cmd = sub.add_parser("set", help="set title and derived slug for one task")
    set_cmd.add_argument("selector", help="task uuid/id/slug/title")
    set_cmd.add_argument("title", help="human title, e.g. 'Grove Workstreams'")
    set_cmd.add_argument("--slug", help="override derived slug")
    set_cmd.set_defaults(func=command_set)

    set_slug = sub.add_parser("set-slug", help="set only the slug for one task")
    set_slug.add_argument("selector", help="task uuid/id/slug/title")
    set_slug.add_argument("slug", help="lowercase kebab-case slug")
    set_slug.set_defaults(func=command_set_slug)

    suggest = sub.add_parser("suggest", help="suggest title/slug values")
    suggest.add_argument("selector", nargs="?", help="optional task uuid/id/slug/title")
    suggest.set_defaults(func=command_suggest)

    list_cmd = sub.add_parser("list", help="list pending/waiting workstream titles and slugs")
    list_cmd.set_defaults(func=command_list)

    doctor = sub.add_parser("doctor", help="validate title/slug invariants")
    doctor.add_argument("--cmux", action="store_true", help="also validate open CMUX workspace title/slug mappings")
    doctor.set_defaults(func=command_doctor)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except WorkstreamError as exc:
        print(f"workstream-slug: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
