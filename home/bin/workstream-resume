#!/usr/bin/env python3
"""Resume the AI session for one stowed CMUX workstream workspace."""

from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys
from dataclasses import dataclass

from _workstreams.cmux import workspaces as cmux_workspaces
from _workstreams.errors import WorkstreamError
from _workstreams.models import CmuxWorkspace, Task
from _workstreams.resolve import UUID_RE, resolve_cmux_workspace


@dataclass
class Resolved:
    workspace: CmuxWorkspace
    task: Task
    command: str


class WorkstreamResumeError(Exception):
    pass


def run(args: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(args, text=True, capture_output=True, check=check)
    except FileNotFoundError as exc:
        raise WorkstreamResumeError(f"missing executable: {args[0]}") from exc
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        raise WorkstreamResumeError(f"{' '.join(args)} failed: {detail}") from exc


def current_workspace_ref() -> str:
    return run(["cmux", "current-workspace"]).stdout.strip()


def resolve_workspace(selector: str | None) -> CmuxWorkspace:
    selector = selector or current_workspace_ref()
    matches = [
        workspace
        for workspace in cmux_workspaces()
        if selector in {workspace.ref, workspace.id, workspace.title}
    ]
    if not matches:
        raise WorkstreamResumeError(f"could not find CMUX workspace {selector!r}")
    if len(matches) > 1:
        choices = ", ".join(f"{item.display_ref} {item.title}" for item in matches)
        raise WorkstreamResumeError(f"CMUX workspace {selector!r} is ambiguous: {choices}")
    return matches[0]


def resolve_task(workspace: CmuxWorkspace) -> Task:
    try:
        return resolve_cmux_workspace(workspace).task
    except WorkstreamError as exc:
        raise WorkstreamResumeError(str(exc)) from exc


def command_for_session(task: Task) -> str:
    session = task.aisession
    if not session:
        raise WorkstreamResumeError(f"task {task.uuid} has no aisession field")

    if session.startswith("codex:"):
        session_id = session.removeprefix("codex:")
        if not session_id:
            raise WorkstreamResumeError("codex aisession is empty")
        return f"codex resume {session_id}"
    if session.startswith("claude:"):
        session_id = session.removeprefix("claude:")
        if not session_id:
            raise WorkstreamResumeError("claude aisession is empty")
        return f"claude --resume {session_id}"
    if session.startswith("pi:"):
        session_id = session.removeprefix("pi:")
        if not session_id:
            raise WorkstreamResumeError("pi aisession is empty")
        return f"pi --session {session_id}"
    if UUID_RE.fullmatch(session):
        return f"codex resume {session}"
    if "claude" in task.tags:
        return f"claude --resume {session}"

    raise WorkstreamResumeError(
        f"task {task.uuid} has aisession {session!r}, but I do not know whether it is codex, claude, or pi"
    )


def resolve(selector: str | None) -> Resolved:
    workspace = resolve_workspace(selector)
    task = resolve_task(workspace)
    command = command_for_session(task)
    return Resolved(workspace=workspace, task=task, command=command)


def shell_ready(workspace_ref: str, surface: str | None) -> tuple[bool, str]:
    args = ["cmux", "read-screen", "--workspace", workspace_ref, "--scrollback", "--lines", "8"]
    if surface:
        args.extend(["--surface", surface])
    result = subprocess.run(args, text=True, capture_output=True)
    if result.returncode != 0:
        return False, (result.stderr or result.stdout).strip()
    lines = [line.strip() for line in result.stdout.rstrip().splitlines() if line.strip()]
    if not lines:
        return True, ""
    return lines[-1].endswith(("\u276f", "$", "%", "#", ">")), lines[-1]


def is_current_cmux_workspace(workspace: CmuxWorkspace) -> bool:
    current_id = os.environ.get("CMUX_WORKSPACE_ID")
    if not current_id:
        return False
    return current_id.lower() == workspace.id.lower()


def exec_local(command: str) -> None:
    argv = shlex.split(command)
    if not argv:
        raise WorkstreamResumeError("resolved resume command is empty")
    os.execvp(argv[0], argv)


def send_command(workspace_ref: str, command: str, *, surface: str | None, force: bool) -> None:
    ready, last = shell_ready(workspace_ref, surface)
    if not ready and not force:
        raise WorkstreamResumeError(
            f"target does not look like an idle shell"
            + (f" (last line: {last!r})" if last else "")
            + "; use --force to send anyway"
        )

    if surface:
        run(["cmux", "send-panel", "--workspace", workspace_ref, "--panel", surface, command])
        run(["cmux", "send-key-panel", "--workspace", workspace_ref, "--panel", surface, "Enter"])
    else:
        run(["cmux", "send", "--workspace", workspace_ref, command])
        run(["cmux", "send-key", "--workspace", workspace_ref, "Enter"])


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-n", "--dry-run", action="store_true", help="print the resolved task and command without sending it")
    parser.add_argument("-w", "--workspace", help="CMUX workspace ref, UUID, or title; defaults to current workspace")
    parser.add_argument("-p", "--pane", "--surface", dest="surface", help="CMUX surface/panel ref to send to; defaults to selected surface")
    parser.add_argument("--force", action="store_true", help="send even if the target does not look like an idle shell")
    args = parser.parse_args(argv)

    try:
        resolved = resolve(args.workspace)
        workspace_ref = resolved.workspace.ref
        task = resolved.task

        if args.dry_run:
            print(f"workspace: {workspace_ref} {resolved.workspace.title}")
            print(f"task:      {task.id} {task.uuid}")
            print(f"state:     {', '.join(sorted(task.tags)) or '-'}")
            print(f"session:   {task.aisession}")
            print(f"command:   {resolved.command}")
            print("dry-run:   not sent")
            return 0

        if args.workspace is None and args.surface is None and is_current_cmux_workspace(resolved.workspace):
            exec_local(resolved.command)

        # Check shell readiness before printing anything. When sending to a CMUX
        # terminal from another terminal, status output in this process should
        # not pollute the target's idle-shell check.
        send_command(workspace_ref, resolved.command, surface=args.surface, force=args.force)
        print(f"workspace: {workspace_ref} {resolved.workspace.title}")
        print(f"task:      {task.id} {task.uuid}")
        print(f"state:     {', '.join(sorted(task.tags)) or '-'}")
        print(f"session:   {task.aisession}")
        print(f"command:   {resolved.command}")
        print("sent:      yes")
        return 0
    except WorkstreamResumeError as exc:
        print(f"workstream-resume: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
