#!/usr/bin/env python3
"""Resume the AI session for one stowed CMUX workstream workspace."""

from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass
from enum import Enum

from _workstreams.cmux import workspaces as cmux_workspaces
from _workstreams.errors import WorkstreamError
from _workstreams.models import CmuxWorkspace, Task
from _workstreams.resolve import resolve_cmux_workspace


LEGACY_CODEX_SESSION_RE = re.compile(
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
)


class WorkstreamResumeError(Exception):
    pass


class Agent(str, Enum):
    CODEX = "codex"
    CLAUDE = "claude"
    PI = "pi"


@dataclass(frozen=True)
class ResumePlan:
    workspace: CmuxWorkspace
    task: Task
    session: "AgentSession"
    target: "ResumeTarget"

    @property
    def argv(self) -> tuple[str, ...]:
        return self.session.argv

    @property
    def command_text(self) -> str:
        return self.session.command_text

    @property
    def workspace_ref(self) -> str:
        return self.workspace.ref or self.workspace.id


@dataclass(frozen=True)
class AgentSession:
    agent: Agent
    session_id: str
    legacy: bool = False

    def __post_init__(self) -> None:
        if not isinstance(self.agent, Agent):
            raise ValueError(f"unsupported AI agent {self.agent!r}")
        if not self.session_id:
            raise ValueError("agent session id cannot be empty")

    @classmethod
    def from_task(cls, task: Task) -> "AgentSession":
        session = task.aisession
        if not session:
            raise WorkstreamResumeError(f"task {task.uuid} has no aisession field")
        session = session.strip()

        if "claude" in task.tags and not session.startswith(("codex:", "claude:", "pi:")):
            return cls(Agent.CLAUDE, session, legacy=True)

        if session.startswith("codex:"):
            session_id = session.removeprefix("codex:")
            if not session_id:
                raise WorkstreamResumeError("codex aisession is empty")
            return cls(Agent.CODEX, session_id)
        if session.startswith("claude:"):
            session_id = session.removeprefix("claude:")
            if not session_id:
                raise WorkstreamResumeError("claude aisession is empty")
            return cls(Agent.CLAUDE, session_id)
        if session.startswith("pi:"):
            session_id = session.removeprefix("pi:")
            if not session_id:
                raise WorkstreamResumeError("pi aisession is empty")
            return cls(Agent.PI, session_id)

        # Older workstream tasks stored Codex session ids without the codex:
        # prefix. Keep this as a migration fallback, but prefer explicit prefixes.
        if LEGACY_CODEX_SESSION_RE.fullmatch(session):
            return cls(Agent.CODEX, session, legacy=True)

        raise WorkstreamResumeError(
            f"task {task.uuid} has aisession {session!r}, but I do not know whether it is codex, claude, or pi"
        )

    @property
    def argv(self) -> tuple[str, ...]:
        if self.agent == Agent.CODEX:
            return ("codex", "resume", self.session_id)
        if self.agent == Agent.CLAUDE:
            return ("claude", "--resume", self.session_id)
        if self.agent == Agent.PI:
            return ("pi", "--session", self.session_id)
        raise WorkstreamResumeError(f"unsupported AI agent {self.agent.value!r}")

    @property
    def command_text(self) -> str:
        return shlex.join(self.argv)


class TargetMode(str, Enum):
    CURRENT_TERMINAL = "current-terminal"
    NEW_PANE = "new-pane"
    EXISTING_PANEL = "existing-panel"


@dataclass(frozen=True)
class ResumeTarget:
    mode: TargetMode
    panel: str | None = None

    def __post_init__(self) -> None:
        if self.mode == TargetMode.EXISTING_PANEL and not self.panel:
            raise ValueError("existing-panel target requires a panel")
        if self.mode != TargetMode.EXISTING_PANEL and self.panel:
            raise ValueError(f"{self.mode.value} target cannot carry a panel")

    @classmethod
    def from_args(cls, *, workspace: str | None, panel: str | None) -> "ResumeTarget":
        if panel:
            return cls(TargetMode.EXISTING_PANEL, panel)
        if workspace:
            return cls(TargetMode.NEW_PANE)
        return cls(TargetMode.CURRENT_TERMINAL)

    @property
    def label(self) -> str:
        return self.mode.value


class CmuxClient:
    def run(self, args: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
        try:
            return subprocess.run(args, text=True, capture_output=True, check=check)
        except FileNotFoundError as exc:
            raise WorkstreamResumeError(f"missing executable: {args[0]}") from exc
        except subprocess.CalledProcessError as exc:
            detail = (exc.stderr or exc.stdout or "").strip()
            raise WorkstreamResumeError(f"{' '.join(args)} failed: {detail}") from exc

    def current_workspace_ref(self) -> str:
        if workspace_id := os.environ.get("CMUX_WORKSPACE_ID"):
            return workspace_id
        return self.run(["cmux", "current-workspace"]).stdout.strip()

    def resolve_workspace(self, selector: str | None) -> CmuxWorkspace:
        selector = selector or self.current_workspace_ref()
        matches = [
            workspace
            for workspace in cmux_workspaces()
            if selector in {workspace.ref, workspace.id, workspace.title}
        ]
        if not matches:
            raise WorkstreamResumeError(f"could not find CMUX workspace {selector!r}")
        if len(matches) > 1:
            choices = ", ".join(f"{item.display_ref} {item.title}" for item in matches)
            raise WorkstreamResumeError(f"CMUX workspace {selector!r} is ambiguous: {choices}")
        return matches[0]

    def run_in_new_pane(self, plan: ResumePlan) -> None:
        self.run(
            [
                "cmux",
                "new-pane",
                "--type",
                "terminal",
                "--workspace",
                plan.workspace_ref,
                "--focus",
                "true",
            ]
        )
        self.run(
            [
                "cmux",
                "respawn-pane",
                "--workspace",
                plan.workspace_ref,
                "--command",
                plan.command_text,
            ]
        )

    def send_to_existing_panel(self, plan: ResumePlan, *, force: bool) -> None:
        panel = plan.target.panel
        if not panel:
            raise WorkstreamResumeError("existing panel target has no panel")
        if not force:
            raise WorkstreamResumeError(
                "refusing to send into an existing CMUX surface without --force; "
                "omit --surface/--pane to create a fresh pane instead"
            )
        self.run(
            [
                "cmux",
                "send-panel",
                "--workspace",
                plan.workspace_ref,
                "--panel",
                panel,
                f"{plan.command_text}\\n",
            ]
        )


def resolve_task(workspace: CmuxWorkspace) -> Task:
    try:
        return resolve_cmux_workspace(workspace).task
    except WorkstreamError as exc:
        raise WorkstreamResumeError(str(exc)) from exc


def build_plan(selector: str | None, target: ResumeTarget, cmux: CmuxClient) -> ResumePlan:
    workspace = cmux.resolve_workspace(selector)
    task = resolve_task(workspace)
    session = AgentSession.from_task(task)
    return ResumePlan(workspace=workspace, task=task, session=session, target=target)


def exec_local(plan: ResumePlan) -> None:
    if not plan.argv:
        raise WorkstreamResumeError("resolved resume command is empty")
    os.execvp(plan.argv[0], plan.argv)


def execute_plan(plan: ResumePlan, cmux: CmuxClient, *, force: bool) -> None:
    if plan.target.mode == TargetMode.CURRENT_TERMINAL:
        exec_local(plan)
    elif plan.target.mode == TargetMode.EXISTING_PANEL:
        cmux.send_to_existing_panel(plan, force=force)
    elif plan.target.mode == TargetMode.NEW_PANE:
        cmux.run_in_new_pane(plan)
    else:
        raise WorkstreamResumeError(f"unsupported resume target {plan.target.mode.value!r}")


def print_plan(plan: ResumePlan, *, dry_run: bool) -> None:
    print(f"workspace: {plan.workspace_ref} {plan.workspace.title}")
    print(f"task:      {plan.task.id} {plan.task.uuid}")
    print(f"state:     {', '.join(sorted(plan.task.tags)) or '-'}")
    print(f"session:   {plan.task.aisession}")
    print(f"target:    {plan.target.label}")
    print(f"command:   {plan.command_text}")
    if dry_run:
        print("dry-run:   not sent")
    else:
        print("sent:      yes")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-n", "--dry-run", action="store_true", help="print the resolved task and command without sending it")
    parser.add_argument("-w", "--workspace", help="CMUX workspace ref, UUID, or title; defaults to current workspace")
    parser.add_argument("-p", "--pane", "--surface", dest="panel", help="existing CMUX surface/panel ref to send to")
    parser.add_argument("--force", action="store_true", help="allow sending into an explicitly targeted existing surface/panel")
    args = parser.parse_args(argv)

    try:
        cmux = CmuxClient()
        target = ResumeTarget.from_args(workspace=args.workspace, panel=args.panel)
        plan = build_plan(args.workspace, target, cmux)

        if args.dry_run:
            print_plan(plan, dry_run=True)
            return 0

        execute_plan(plan, cmux, force=args.force)
        print_plan(plan, dry_run=False)
        return 0
    except WorkstreamResumeError as exc:
        print(f"workstream-resume: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
